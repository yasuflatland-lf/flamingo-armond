# Root .env template -- copy to `.env` (gitignored) and fill in real values.
#
# This is the single place a developer edits secrets for local Supabase auth.
# `mise` auto-exports these into the shell via mise.toml so `supabase start`
# resolves the env() placeholders in supabase/config.toml.

# Google OAuth client for LOCAL development.
# Create in Google Cloud Console; see docs/dev-setup.md section "Supabase CLI"
# -> "Auth flow (read this first)".
# Production uses a SEPARATE client -- see docs/deployment.md section
# "Manual prerequisites" -> Google OAuth client.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=YOUR_GOOGLE_SECRET_HERE

# Production deploy tokens, consumed by `make setup-prod-preflight`.
# Local-only developers can leave these blank; presence and reachability are
# validated against each provider's API at preflight time, not at `make setup`.
# Issue URLs:
#   SUPABASE_ACCESS_TOKEN -> https://supabase.com/dashboard/account/tokens
#   RENDER_API_KEY        -> https://dashboard.render.com/u/<user>/account/api-keys
#   VERCEL_API_TOKEN      -> https://vercel.com/account/tokens
SUPABASE_ACCESS_TOKEN=YOUR_SUPABASE_PAT_HERE
RENDER_API_KEY=YOUR_RENDER_API_KEY_HERE
VERCEL_API_TOKEN=YOUR_VERCEL_TOKEN_HERE
