# Root .env template -- copy to `.env` (gitignored) and fill in real values.
#
# This is the single place a developer edits secrets for local Supabase auth.
# `mise` auto-exports these into the shell via mise.toml so `supabase start`
# resolves the env() placeholders in supabase/config.toml.

# Google OAuth client for LOCAL development.
# Create in Google Cloud Console; see docs/dev-setup.md section "Supabase CLI"
# -> "Auth flow (read this first)".
# Production uses a SEPARATE client -- see docs/deployment.md section
# "Manual prerequisites" -> Google OAuth client.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=YOUR_GOOGLE_SECRET_HERE

# Production deploy tokens, consumed by `make setup-prod-preflight`.
# Local-only developers can leave these blank; presence and reachability are
# validated against each provider's API at preflight time, not at `make setup`.
# Issue URLs:
#   SUPABASE_ACCESS_TOKEN -> https://supabase.com/dashboard/account/tokens
#   RENDER_API_KEY        -> https://dashboard.render.com/u/<user>/account/api-keys
#   VERCEL_API_TOKEN      -> https://vercel.com/account/tokens
SUPABASE_ACCESS_TOKEN=YOUR_SUPABASE_PAT_HERE
RENDER_API_KEY=YOUR_RENDER_API_KEY_HERE
VERCEL_API_TOKEN=YOUR_VERCEL_TOKEN_HERE

# Comma-separated email addresses that receive admin role on login.
# Consumed by `make setup-prod-postapply` to write the value to Render.
# Leave blank if no super-users are needed.
SUPER_USER_EMAILS=

# Notion sync settings copied to Render for the backend service.
NOTION_TOKEN=
NOTION_PAGE_IDS=
# Email of the Supabase account that owns the synced cardgroup.
# make sync-notion-secrets resolves this to a UUID automatically via production
# Supabase. The account must have signed in to the production app at least once.
# If you prefer to supply the UUID directly, leave this blank and set
# NOTION_TARGET_OWNER_ID instead.
NOTION_TARGET_OWNER_EMAIL=
# Fallback: set only when NOTION_TARGET_OWNER_EMAIL is blank.
# NOTION_TARGET_OWNER_ID=
NOTION_TARGET_CARDGROUP_NAME=
NOTION_SYNC_TOKEN=
NOTION_MAX_ATTEMPTS=5
NOTION_MAX_ELAPSED=2m

# Local Supabase Postgres connection string. Run `supabase status` to confirm
# port (default 54322 for the supabase-cli local stack). Required by
# notion-local-setup to resolve NOTION_LOCAL_TARGET_OWNER_EMAIL → UUID.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Notion sync — local testing only (never pushed to Render; sync-notion-secrets
# uses an explicit allowlist that excludes NOTION_LOCAL_*).
NOTION_LOCAL_TARGET_OWNER_EMAIL=
NOTION_LOCAL_TARGET_CARDGROUP_NAME=Local Notion Test
NOTION_LOCAL_SYNC_TOKEN=local-dev-token
