# Root .env template -- copy to `.env` (gitignored) and fill in real values.
#
# This is the single place a developer edits secrets for local Supabase auth.
# `mise` auto-exports these into the shell via mise.toml so `supabase start`
# resolves the env() placeholders in supabase/config.toml.

# Google OAuth client for LOCAL development.
# Create in Google Cloud Console; see docs/dev-setup.md section "Supabase CLI"
# -> "Auth flow (read this first)".
# Production uses a SEPARATE client managed via Terraform -- see
# docs/deployment.md section "Manual prerequisites" -> Google OAuth client.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=YOUR_GOOGLE_SECRET_HERE
