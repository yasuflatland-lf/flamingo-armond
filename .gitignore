# Brainstorm visual companion artifacts
.superpowers/
docs/superpowers/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage
*.lcov

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# dotenv environment variable files
.env
.env.*
!.env.example

# Next.js build output
.next
out

# Playwright local output
playwright-report/
test-results/

# Vite logs files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Claude Code
/.claude/plans
backend/server

# Generated code — regenerated locally and in CI. Both sides are ignored; see
# docs/dev-setup.md §"Policy on generated files".
/backend/graph/generated/
/backend/graph/model/models_gen.go
/frontend/src/generated/

# Next.js auto-generated TypeScript shim. Toggles import paths between
# `next dev` and `next build` runs (Next.js 16 `isolatedDevBuild`), so
# committing it produces a churn loop. Regenerated on every Next.js
# invocation; see docs/dev-setup.md §"Policy on generated files".
/frontend/next-env.d.ts

# Generated Service Worker. Produced by `frontend/scripts/stamp-sw-version.mjs`
# from `sw-template.js`; regenerated on every dev/build with a deterministic
# version hash. Edit the template, never this output.
/frontend/public/sw.js

# Stryker mutation-testing output (HTML report + incremental cache) and its
# sandbox temp dir. Regenerated by `pnpm --filter frontend test:mutation`.
/frontend/reports/
/frontend/.stryker-tmp/

# Supabase CLI local state
supabase/.branches/
supabase/.temp/

# Production bring-up state (single-operator local artifact, mode 0600).
# Ansible's `copy: backup: yes` writes timestamped backups of the form
# `.setup-prod.state.yml.<timestamp>~`, NOT plain `.setup-prod.state.yml~`.
# The glob below catches both shapes so backups (which contain the DB
# password) cannot be staged accidentally via `git add .`.
.setup-prod.state.yml
.setup-prod.state.yml.*~
.setup-prod.state.yml~

# Teardown event records from production bring-up.
/.setup-prod-archive/
.playwright-mcp/
*~
