# Copy to frontend/.env.local (gitignored) and tweak for local dev.

# Backend base URL — rewritten from /api/graphql in next.config.ts.
# Matches `cmd/server` PORT default in docs/backend.md.
BACKEND_URL=http://localhost:1323

# Supabase local dev — replace the key with the `Publishable` value from
# `supabase start` (printed under "Authentication Keys"). The env name keeps
# the Supabase JS SDK's legacy `_ANON_KEY` slot; the value is now Publishable.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_replace_with_supabase_start_output
