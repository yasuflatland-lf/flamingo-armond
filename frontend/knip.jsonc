{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // `sw-template.js` is the Service Worker source. It is never imported — the
  // pre-build script `scripts/stamp-sw-version.mjs` reads it via `readFileSync`
  // and writes the stamped `public/sw.js`. knip only traces the module-import
  // graph, so it falsely reports the template as an unused file.
  //
  // `scripts/gen-ios-splash.mjs` is a manually-run generator (Node built-ins
  // only) that writes the apple-touch-startup-image PNGs into public/splash/.
  // It is wired into neither prebuild nor CI, so knip's import-graph trace
  // falsely reports it as an unused file.
  "ignore": ["sw-template.js", "scripts/gen-ios-splash.mjs"]
}
