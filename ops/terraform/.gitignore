# Terraform state — never commit. Contains secrets and project refs.
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log

# Local provider cache and module cache.
.terraform/
.terraform.tfstate.lock.info

# Plan files — may contain secrets.
*.tfplan
*.tfplan.*

# mise local overrides — secrets only. The example file is committed.
mise.local.toml
.mise.local.toml

# Optional CLI configs.
.terraformrc
terraform.rc

# Variable files outside the example template.
*.auto.tfvars
*.auto.tfvars.json
terraform.tfvars
terraform.tfvars.json
